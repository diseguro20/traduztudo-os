# ==============================================================================
# MÓDULO DE ASSINATURA DIGITAL (CLICKSIGN)
# ==============================================================================
# Defina o ambiente como 'sandbox' (teste) ou 'production' (produção)
CLICKSIGN_ENVIRONMENT=sandbox
NEXT_PUBLIC_SIGNATURE_ENVIRONMENT=sandbox

# URLs da API Clicksign
CLICKSIGN_SANDBOX_URL=https://sandbox.clicksign.com/api/v1
CLICKSIGN_PROD_URL=https://app.clicksign.com/api/v1

# Token de acesso fornecido no painel da Clicksign
CLICKSIGN_ACCESS_TOKEN=seu_access_token_aqui
CLICKSIGN_API_KEY=seu_access_token_aqui

# Segredo de validação de webhooks Clicksign (HMAC SHA-256)
CLICKSIGN_WEBHOOK_SECRET=seu_webhook_secret_aqui

# ==============================================================================
# MÓDULO DE OCR & PROCESSAMENTO DE DOCUMENTOS
# ==============================================================================
OCR_DEFAULT_LANGUAGES=por,eng,ita,spa,fra,deu
OCR_AUTO_DESKEW=true
OCR_CLEAN_NOISE=true
OCR_IGNORE_REPEATED_HEADERS=true
