NEXT_PUBLIC_APP_NAME="TraduzTudo OS"
NEXT_PUBLIC_APP_URL="https://traduztudo-os.vercel.app"
NEXT_PUBLIC_API_SECRET_KEY="traduztudo-saas-api-secret-key-2026"

# ==============================================================================
# MÓDULO DE ASSINATURA DIGITAL (CLICKSIGN)
# ==============================================================================
# Defina o ambiente como 'sandbox' (teste) ou 'production' (produção)
CLICKSIGN_ENVIRONMENT=sandbox
NEXT_PUBLIC_SIGNATURE_ENVIRONMENT=sandbox

# URLs da API Clicksign
CLICKSIGN_SANDBOX_URL=https://sandbox.clicksign.com/api/v1
CLICKSIGN_PROD_URL=https://app.clicksign.com/api/v1

# Token de acesso fornecido no painel da Clicksign
CLICKSIGN_ACCESS_TOKEN=seu_access_token_aqui
CLICKSIGN_API_KEY=seu_access_token_aqui

# Segredo de validação de webhooks Clicksign (HMAC SHA-256)
CLICKSIGN_WEBHOOK_SECRET=seu_webhook_secret_aqui

# ==============================================================================
# MÓDULO DE OCR & PROCESSAMENTO DE DOCUMENTOS
# ==============================================================================
OCR_DEFAULT_LANGUAGES=por,eng,ita,spa,fra,deu
OCR_AUTO_DESKEW=true
OCR_CLEAN_NOISE=true
OCR_IGNORE_REPEATED_HEADERS=true

# ==============================================================================
# CENTRAL DE E-MAILS & HOSTINGER MAIL (contato@traduztudo.com)
# ==============================================================================
# Endpoint do Webhook na Vercel: https://traduztudo-os.vercel.app/api/webhooks/hostinger-mail
# Segredo compartilhado para validação Bearer do Webhook Hostinger (Authorization: Bearer <TOKEN>)
HOSTINGER_WEBHOOK_SECRET=seu_token_secreto_webhook_hostinger_aqui

# Token oficial da API Hostinger Mail (quando disponível para automação direta)
HOSTINGER_API_TOKEN=seu_token_api_hostinger_aqui
HOSTINGER_API_URL=https://api.hostinger.com/v1/mail

# Configurações de SMTP Corporativo Hostinger (Alternativa para envio autenticado)
HOSTINGER_SMTP_HOST=smtp.hostinger.com
HOSTINGER_SMTP_PORT=465
HOSTINGER_SMTP_USER=contato@traduztudo.com
HOSTINGER_SMTP_PASS=sua_senha_ou_app_password_aqui

# REGRA DE SEGURANÇA: Modo de Envio Automático (false = simulação/aprovação humana obrigatória)
AUTO_SEND=false

# ==============================================================================
# MOTOR DE INTELIGÊNCIA ARTIFICIAL (TRADUZ TUDO AI AGENT)
# ==============================================================================
# Chave da API Google Gemini ou OpenAI para o agente de triagem e geração de rascunhos
# (O sistema possui motor especialista heurístico de contingência caso a chave não esteja definida)
GEMINI_API_KEY=sua_chave_gemini_aqui
OPENAI_API_KEY=sua_chave_openai_aqui

