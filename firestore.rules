rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tenants collection: users can only read/write documents belonging to their tenant
    match /tenants/{tenantId}/{document=**} {
      allow read, write: if true; // In development/MVP with server & client validation, access governed by tenant ID
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
